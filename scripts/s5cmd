#!/usr/bin/env bash

# Wrapper around the real s5cmd binary (bin/.s5cmd) that points it at the local
# bucket, so `bin/s5cmd ls` works with nothing exported: s5cmd has no alias file of
# its own. `make s5cmd-cli` symlinks bin/s5cmd here. `bin/s5cmd print-env` prints
# the same settings for other S3 tools.

set -euo pipefail

ROOT=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )
BINARY="${ROOT}/bin/.s5cmd"
CONTEXT="kind-${PLATFORM_CLUSTER_NAME:-platform}"
# The nodePort the kind config maps onto the host.
BUCKET_ENDPOINT="http://localhost:31337"
BUCKET_ENV_VARS=(AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION S3_ENDPOINT_URL)

bucket_credential() {
    kubectl --context "${CONTEXT}" get secret bucket-credentials --namespace default \
        --output jsonpath="{.data.$1}" 2>/dev/null | base64 --decode
}

load_bucket_env() {
    local access_key secret_key
    access_key="$(bucket_credential accessKeyID)" || return 1
    secret_key="$(bucket_credential secretAccessKey)" || return 1
    [ -n "${access_key}" ] && [ -n "${secret_key}" ] || return 1

    export AWS_ACCESS_KEY_ID="${access_key}"
    export AWS_SECRET_ACCESS_KEY="${secret_key}"
    export AWS_REGION="us-east-1"
    export S3_ENDPOINT_URL="${BUCKET_ENDPOINT}"
}

no_bucket() {
    echo "no local bucket found on ${CONTEXT}: is the platform cluster running?" >&2
}

# Subcommands that touch no bucket stay usable without a cluster.
needs_bucket() {
    case "${1:-}" in
        ""|-*|version|help) return 1 ;;
        *) return 0 ;;
    esac
}

if [ "${1:-}" = "print-env" ]; then
    load_bucket_env || { no_bucket; exit 1; }
    for var in "${BUCKET_ENV_VARS[@]}"; do
        echo "export ${var}=${!var}"
    done
    exit 0
fi

if [ ! -x "${BINARY}" ]; then
    echo "s5cmd is not installed; run 'make s5cmd-cli'" >&2
    exit 1
fi

# An endpoint in the environment means the caller is targeting something
# deliberately, so leave it alone. Otherwise refuse rather than fall through to the
# default AWS endpoint, where ambient credentials could point an `rm` at a real
# account.
if [ -z "${S3_ENDPOINT_URL:-}" ] && needs_bucket "${1:-}"; then
    if ! load_bucket_env; then
        no_bucket
        echo "refusing to run '$1' against the default AWS endpoint." >&2
        echo "set S3_ENDPOINT_URL to target something else deliberately." >&2
        exit 1
    fi
fi

exec "${BINARY}" "$@"
